# shellcheck disable=SC2034
# =====================================================================
# 本番環境用 .env テンプレート（構成のみ・ダミー値。未確定項目は空欄）
# ※ 現時点では本番設定は行わない。ユーザー承認後の Phase 5 で確定する。
# ※ 本番の production/.env はVPS上でのみ生成し、ローカルやGitへコピーしない。
# JITSI_IMAGE_VERSION はここに書かない（VERSION.env で一元管理）。
# =====================================================================

CONFIG=~/.jitsi-meet-cfg/production

# 本番ポート（VPSの既存Webサーバーとの競合調査後に確定）
HTTP_PORT=
HTTPS_PORT=

TZ=Asia/Tokyo

# 例: https://meet.oriental-network.com （DNS確認後に設定）
PUBLIC_URL=

# VPSのグローバルIP（確認後に設定）
JVB_ADVERTISE_IPS=

# TLS（Let's Encrypt を使う場合。ドメイン・連絡先メール確定後に設定）
#ENABLE_LETSENCRYPT=1
#LETSENCRYPT_DOMAIN=
#LETSENCRYPT_EMAIL=
#ENABLE_HTTP_REDIRECT=1
#ENABLE_HSTS=1

# 認証（Phase 3 のローカル検証結果に基づき確定する。推測で有効化しない）
#ENABLE_AUTH=1
#ENABLE_GUESTS=1
#AUTH_TYPE=jwt
#JWT_APP_ID=
#JWT_APP_SECRET=
#ENABLE_LOBBY=1

# --- サービス間パスワード（VPS上で init-env.sh production により生成）---
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

RESTART_POLICY=unless-stopped

# スマホでの「Jitsi Meet アプリで開く」案内を表示しない（公式アプリへ誘導しない）
DISABLE_DEEP_LINKING=true
