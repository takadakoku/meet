# shellcheck disable=SC2034
# =====================================================================
# ローカル開発環境用 .env テンプレート（ダミー値のみ）
# 実ファイル local/.env は scripts/init-env.sh local で生成する。
# 項目の正式な説明: upstream/docker-jitsi-meet-*/env.example および
# https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker
# JITSI_IMAGE_VERSION はここに書かない（VERSION.env で一元管理）。
# =====================================================================

# 設定・永続化ディレクトリ（Webルート外。本番と別ディレクトリにする）
CONFIG=~/.jitsi-meet-cfg/local

# 公開ポート。ローカルではLANへ公開しないよう 127.0.0.1 にバインドする
# （公式 compose の '${HTTP_PORT}:8000' に展開され '127.0.0.1:8000:8000' となる）
HTTP_PORT=127.0.0.1:8000
HTTPS_PORT=127.0.0.1:8443

TZ=Asia/Tokyo

# ブラウザでアクセスするURL（非標準ポートはURLに含める）
PUBLIC_URL=https://localhost:8443

# LAN内の別端末から検証する場合のみ、PCのLAN IPを設定する（HTTPS_PORTのバインドも要変更）
#JVB_ADVERTISE_IPS=192.168.x.x

# 開発PCのメモリ節約（JVMヒープ上限）
JICOFO_MAX_MEMORY=512m
VIDEOBRIDGE_MAX_MEMORY=1024m

# 認証: Phase 1（基本会議テスト）では無効。Phase 3 で JWT を検証する。
#ENABLE_AUTH=1
#ENABLE_GUESTS=1
#AUTH_TYPE=jwt

# --- サービス間パスワード（init-env.sh が openssl rand -hex 16 で生成）---
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
# Jigasi / Jibri は導入しないが、公式 gen-passwords.sh と同様に値を生成しておく
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

RESTART_POLICY=unless-stopped

# スマホでの「Jitsi Meet アプリで開く」案内を表示しない（公式アプリへ誘導しない）
DISABLE_DEEP_LINKING=true

# --- 認証（Phase 5: JWT + ゲスト + 主催者待ち）---
# 根拠: Handbook「Authentication (Token)」「Docker」、stable-11248-3 の prosody/jicofo テンプレート
# 主催者: JWT（scripts/issue-meeting.sh で発行）で入室し、会議を開始・モデレーター権限を持つ
# ゲスト: ログイン不要。主催者が来るまでは待機画面（ロビー）で待つ。モデレーターにはならない
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=oriental-meet
# JWT 署名鍵（init-env.sh が openssl rand -hex 32 で生成。Git・ブラウザ・URL・ログに出さない）
JWT_APP_SECRET=
ENABLE_GUESTS=1
# Handbook: トークン認証では Jicofo 側の認証（旧 Secure Domain 方式）を無効にする
JICOFO_ENABLE_AUTH=0
# 主催者が居ないときに Jicofo がゲストを自動でモデレーターにしない
ENABLE_AUTO_OWNER=0
# ゲストを主催者到着まで待機させる公式モジュール（Handbook「Enable wait for host module」）
XMPP_MODULES=persistent_lobby
XMPP_MUC_MODULES=muc_wait_for_host
ENABLE_LOBBY=1

# --- 会議URL発行画面（/host/。主催者が ID・パスワードでログインして会議URLを発行）---
# セッション Cookie の署名鍵（init-env.sh が openssl rand -hex 32 で生成。表示・共有しない）
ISSUER_SESSION_SECRET=
